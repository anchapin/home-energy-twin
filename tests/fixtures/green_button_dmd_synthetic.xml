<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic Green Button "Download My Data" (DMD) export.

  LAW-11: every value, identifier and timestamp in this file is synthetic.
  No real meter, account, household or address appears here.

  Shapes deliberately exercised:
    * hourly IntervalBlock readings on an electricity import usage point;
    * one estimated read (dataQuality = estimated);
    * a one-hour GAP between two interval blocks (no 11:00 reading);
    * two Summation billing periods with irregular lengths (a 28-day month and
      a 743-hour DST-shortened month in America/New_York);
    * a gas usage point with daily intervals;
    * a net-meter usage point (readingType electricityNet).
-->
<feed xmlns="http://www.w3.org/2005/Atom"
      xmlns:g="http://greenbutton.com/schema/1.0">
